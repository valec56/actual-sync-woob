# ── Mode ──────────────────────────────────────────────────────────────────────
# Which sync path to run:
#   v1 → writes an OFX file to /data (default, no Actual Budget needed)
#   v2 → pushes transactions directly into Actual Budget via its API
SYNC_MODE=v1

# ── Woob ──────────────────────────────────────────────────────────────────────
# Bank account identifier as returned by Woob (woob bank accounts)
WOOB_ACCOUNT_ID=

# Number of transactions to fetch (default: 200)
WOOB_HISTORY_COUNT=200

# ── Export (v1 only) ──────────────────────────────────────────────────────────
# Name of the OFX file generated in the mounted /data folder
OUTPUT_FILENAME=bank_export.ofx

# ── Schedule ──────────────────────────────────────────────────────────────────
# Cron expression for the automatic trigger (default: every day at 5am)
# Format: minute hour day-of-month month day-of-week
CRON_SCHEDULE=0 5 * * *

# ── Actual Budget (v2 only — required when SYNC_MODE=v2) ──────────────────────
# URL of your Actual Budget server (e.g. http://actual:5006)
ACTUAL_SERVER_URL=
# Password used to log into the Actual server
ACTUAL_PASSWORD=
# Sync ID of the budget (Actual → Settings → Advanced → Sync ID)
ACTUAL_BUDGET_ID=
# Account ID inside the budget that should receive the imported transactions
ACTUAL_ACCOUNT_ID=
# End-to-end encryption password — leave empty if the budget is not encrypted
ACTUAL_ENCRYPTION_PASSWORD=
